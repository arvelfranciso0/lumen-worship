{
  "name": "live-worship",
  "version": "1.0.0",
  "private": true,
  "description": "Lumen worship presentation app",
  "author": "Lumen",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve@latest out",
    "lint": "eslint",
    "bible:convert": "node scripts/convert-bible.mjs",
    "electron:dev": "concurrently -k \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "next build && electron-builder"
  },
  "repository": "https://github.com/arvelfranciso0/lumen-worhsip",
  "dependencies": {
    "axios": "^1.18.1",
    "electron-updater": "^6.8.9",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.lumen.worship",
    "productName": "Lumen",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/lumen.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "public/lumen.ico",
      "uninstallerIcon": "public/lumen.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "arvelfranciso0",
      "repo": "lumen-worship-release",
      "releaseType": "release"
    }
  }
}